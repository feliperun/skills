{
  "compilerOptions": {
    "allowJs": true,
    "checkJs": true,
    "noEmit": true,
    "module": "nodenext",
    "moduleResolution": "nodenext",
    "target": "es2022",
    "lib": ["es2023"],
    "strict": true,
    "skipLibCheck": true,
    "types": ["node"]
  },
  "include": [".claude/hooks/**/*.mjs", "skills/mine/intent-factory/src/**/*.mjs",
    "skills/mine/intent-factory/test/**/*.mjs", "bin/**/*.mjs", "test/**/*.mjs", "skills/mine/intent-factory/evals/**/*.mjs"]
}
