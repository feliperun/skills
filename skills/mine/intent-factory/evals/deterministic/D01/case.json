{
  "id": "D01",
  "title": "crash after attempt verification but before integration publishes preserves the accepted result",
  "proves": "a controller killed after the attempt is verified but before the integration transaction publishes the run ref, appends the accepted record and cleans up its worktrees must, on resume, finish that same transaction instead of losing it or re-running the worker",
  "contract": {
    "schemaVersion": 3,
    "contractVersion": "0.3.0",
    "id": "d01-run",
    "campaignId": "d01-campaign",
    "goal": "prove crash-then-resume preserves the accepted capsule",
    "runtimeDefaults": {
      "worker": "replay-worker"
    },
    "runtimes": {
      "replay-worker": {
        "harness": "replay",
        "model": "replay-worker-model",
        "vendor": "replay-worker-vendor",
        "config": {}
      }
    },
    "nodes": [
      {
        "id": "build",
        "type": "backend",
        "phase": "build",
        "taskPacket": {
          "mode": "execution",
          "objective": "write output.txt",
          "instructions": [
            "Write output.txt"
          ],
          "readFiles": [
            "contract.json"
          ],
          "writeFiles": [
            "output.txt"
          ],
          "symbols": [],
          "decisions": [],
          "nonGoals": [],
          "verification": [
            {
              "argv": [
                "true"
              ]
            }
          ]
        },
        "gate": false
      }
    ]
  },
  "recordings": {
    "replay-worker": "worker.jsonl"
  },
  "setup": [
    {
      "type": "run",
      "env": {
        "INTENT_FACTORY_INTEGRATION_INTERRUPT": "before-ref"
      },
      "expectError": "integration interrupted at before-ref"
    },
    {
      "type": "resume"
    }
  ],
  "discriminator": {
    "type": "removeSetupStep",
    "indices": [
      1
    ]
  }
}
